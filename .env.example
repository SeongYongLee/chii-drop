# 환경 변수 예시입니다. 서버는 .env를 자동으로 읽지 않습니다.
# 사용 예: HOST=0.0.0.0 PORT=5180 pnpm dev
HOST=0.0.0.0
PORT=5180
# 비워 두면 접속한 화면과 같은 호스트·포트의 WebSocket만 허용합니다.
ALLOWED_ORIGINS=
# 운영 시 재시작 후에도 유지되는 디스크의 경로를 지정하세요.
ONLINE_DATA_FILE=./data/online.json
# Cloudflare 로컬 검증은 pnpm dev:cloudflare로 실행합니다. 브라우저는 같은 5180 포트를 사용합니다.
# LOCAL_CLOUDFLARE_URL=http://127.0.0.1:8787

# 인터넷 운영 예시: NODE_ENV=production은 정적 파일·로컬 편집 API를 모두 끕니다.
# NODE_ENV=production
# ALLOWED_ORIGINS=https://seongyonglee.github.io
# ONLINE_DATA_FILE=/var/data/online.json
# PORT는 호스팅 서비스가 제공하는 값을 우선 사용합니다.
