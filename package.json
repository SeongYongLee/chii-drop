{
  "name": "chii-drop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "online": "node server/index.js",
    "online:cloudflare": "wrangler dev --local",
    "dev:cloudflare": "node scripts/dev-cloudflare.mjs",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "types:cloudflare": "wrangler types server/cloudflare/env.d.ts --include-runtime false",
    "test:cloudflare": "node test/cloudflare-runtime.mjs",
    "check:git": "node scripts/check-git-ready.mjs",
    "prepare:source": "node scripts/prepare-source.mjs",
    "prepare:pages-assets": "node scripts/prepare-pages-assets.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "build": "node scripts/build-pages.mjs",
    "preview": "node scripts/preview-pages.mjs",
    "verify": "node scripts/verify.mjs",
    "check:online": "node scripts/check-online.mjs",
    "check:online-budget": "node scripts/check-online-budget.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:release": "node scripts/check-release.mjs",
    "assets:sync": "node scripts/prepare-pages-assets.mjs",
    "compare:network": "node scripts/compare-state-stream.mjs",
    "compare:batches": "node scripts/compare-input-batches.mjs",
    "compare:batches-storage": "node scripts/compare-batch-storage.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
