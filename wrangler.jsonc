{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chii-drop-online",
  "main": "server/cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "GameRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://seongyonglee.github.io",
    "MAX_ROOMS": "5",
    "RECONNECT_GRACE_MS": "30000"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "dev": { "port": 8787, "ip": "127.0.0.1" }
}
